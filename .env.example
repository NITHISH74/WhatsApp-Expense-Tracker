# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Copy to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Twilio WhatsApp Sandbox ───────────────────────────────────────────────────
# Get these from https://console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
# For Sandbox: whatsapp:+14155238886
# For production: whatsapp:+your_verified_number
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ── Fernet Encryption Key ─────────────────────────────────────────────────────
# Generate once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Store securely — losing this key means losing access to all encrypted data!
FERNET_KEY=your-44-char-fernet-key-here=

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./expenses.db
DB_FILE_PATH=./expenses.db

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development   # "production" for deployment
LOG_LEVEL=INFO

# ── Spending Alert Thresholds (USD equivalent) ────────────────────────────────
DEFAULT_DAILY_ALERT_THRESHOLD=100.0
DEFAULT_WEEKLY_ALERT_THRESHOLD=500.0
